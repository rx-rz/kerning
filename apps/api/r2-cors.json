{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://kerning.click",
          "https://www.kerning.click"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
